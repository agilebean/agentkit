#!/bin/sh
# Rebuild rules.index.md when RULES.md is staged, so a commit never carries a
# stale index (85bc49a was red on test_the_index_matches_rules_md, 2026-11-23).
cd "$(git rev-parse --show-toplevel)" || exit 0
# agentkit is public: refuse a staged file that holds a term of the private list
# (DD-03; a lint example and a kept quote leaked two of them on 2026-11-23 and 2026-11-25).
if [ -f scripts/private_term_check.py ]; then
  git diff --cached --name-only --diff-filter=ACMR | python3 scripts/private_term_check.py || exit 1
fi
git diff --cached --name-only | grep -qx RULES.md || exit 0
if ! git diff --quiet -- RULES.md; then
  echo "pre-commit: RULES.md has unstaged edits; stage the whole file, then commit" >&2
  exit 1
fi
python3 tools/rules_index.py || exit 1
git add rules.index.md
